# === DocuMind v3 Configuration Example ===
# Copy this file to .env and fill in your actual values

# === Ollama Configuration (Local - Free) ===
# For local Ollama LLM instead of OpenAI:
# 1. Install Ollama: https://ollama.ai
# 2. Run: ollama pull llama3.2
# 3. Run: ollama pull nomic-embed-text
# 4. Run: ollama serve
# 5. Use these settings:
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_CHAT_MODEL=
OPENAI_EMBEDDING_MODEL=

# === OpenAI Configuration (Cloud) - Alternative ===
# For OpenAI API instead of local Ollama, use:
# OPENAI_API_KEY=sk-your-key-here
# OPENAI_BASE_URL=
# OPENAI_CHAT_MODEL=gpt-4o-mini
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
LLM_TEMPERATURE=

# RAG Pipeline Configuration
CHUNK_SIZE=
CHUNK_OVERLAP=
TOP_K_RETRIEVAL=
BM25_WEIGHT=
VECTOR_WEIGHT=
MIN_RELEVANCE_SCORE=
RERANK_ENABLED=

# Memory Configuration
MEMORY_WINDOW_SIZE=

# Application Settings
API_VERSION=
DATA_DIR=
LOG_LEVEL=
