# ── LLM Providers (set at least one) ──────────────────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# ── App config ────────────────────────────────────────
ENVIRONMENT=development
PORT=8000
LOG_LEVEL=INFO

# ── Models ────────────────────────────────────────────
LLM_MODEL=deepseek/deepseek-chat-v3-0324:free
EMBEDDING_MODEL=all-MiniLM-L6-v2
LLM_TEMPERATURE=0.15

# ── RAG config ────────────────────────────────────────
CHUNK_SIZE=512
CHUNK_OVERLAP=64
TOP_K_RETRIEVAL=5

# ── Storage ───────────────────────────────────────────
DATA_DIR=data
MAX_UPLOAD_SIZE_MB=50
MAX_PAGES=100

# ── CORS: comma-separated list of allowed origins ─────
# Production: set to your Vercel URL only
# Example: CORS_ORIGINS=https://documind-ai.vercel.app
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Frontend (optional: served via /env.js) ───────────
FRONTEND_API_URL=

# ── Rate limiting ─────────────────────────────────────
RATE_LIMIT_PER_MINUTE=30
