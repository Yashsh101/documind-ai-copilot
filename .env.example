# === DocuMind v3 Configuration Example ===
# Copy this file to .env and fill in your actual values

# === Ollama Configuration (Local - Free) ===
# For local Ollama LLM instead of OpenAI:
# 1. Install Ollama: https://ollama.ai
# 2. Run: ollama pull llama3.2
# 3. Run: ollama pull nomic-embed-text
# 4. Run: ollama serve
# 5. Use these settings:
OPENAI_API_KEY=ollama
OPENAI_BASE_URL=http://localhost:11434/v1
OPENAI_CHAT_MODEL=llama3.2
OPENAI_EMBEDDING_MODEL=nomic-embed-text

# === OpenAI Configuration (Cloud) - Alternative ===
# For OpenAI API instead of local Ollama, use:
# OPENAI_API_KEY=sk-your-openai-key-here
# OPENAI_BASE_URL=
# OPENAI_CHAT_MODEL=gpt-4o-mini
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
LLM_TEMPERATURE=0.15

# RAG Pipeline Configuration
CHUNK_SIZE=512
CHUNK_OVERLAP=64
TOP_K_RETRIEVAL=5
BM25_WEIGHT=0.35
VECTOR_WEIGHT=0.65
MIN_RELEVANCE_SCORE=0.25
RERANK_ENABLED=true

# Memory Configuration
MEMORY_WINDOW_SIZE=10

# Application Settings
API_VERSION=3.0.0
DATA_DIR=data
LOG_LEVEL=INFO
